rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 정산방 ID(?s=방ID)를 아는 사람만 읽고 쓸 수 있어요.
    // 비밀번호가 걸린 방은 실제 데이터가 "방ID--비밀번호해시" 경로에 있어서 ID만으로는 찾을 수 없어요.
    // 방 목록 전체 조회는 막아서 남의 방 ID를 알아낼 수 없게 해요.
    function validId(id) {
      return id.matches('^[a-z0-9-]{2,30}$');
    }
    function validKey(key) {
      return key.matches('^[a-z0-9-]{2,50}$');
    }

    // 비밀번호가 걸린 방 표시 (만들기만 가능, 수정·삭제 불가)
    match /locks/{room} {
      allow get: if validId(room);
      allow create: if validId(room) && request.resource.data.keys().hasOnly(['at']);
    }

    match /rooms/{key}/trips/{trip} {
      allow get, list: if validKey(key);
      allow create, update: if validKey(key) && request.resource.data.size() <= 20;
      allow delete: if validKey(key);

      match /{sub}/{doc} {
        allow get, list: if validKey(key) && sub in ['items', 'transfers', 'plan'];
        allow create, update: if validKey(key) && sub in ['items', 'transfers', 'plan'] && request.resource.data.size() <= 20;
        allow delete: if validKey(key) && sub in ['items', 'transfers', 'plan'];
      }
    }
  }
}
