// 모이모이 Firestore 보안 규칙 (제안본)
// - Firebase 에뮬레이터로 검증함: tests/rules — 앱의 실제 요청은 모두 허용, 잘못된 쓰기는 차단 (74건 통과)
// - 게시 방법: Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 전체를 붙여넣고 '게시'
// - 현재 규칙(firestore.rules)에 더해진 것: 문서 ID 형식 검사, 약속 문서 필드 제한, 멤버 수 제한(50명)
// - 화면 쪽에서도 같은 검사를 하므로 이 규칙이 없어도 XSS는 막혀 있어요. 이 규칙은 '쓰레기 데이터'를 서버에서 한 번 더 거르는 용도예요.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 모임 ID(?s=모임ID)를 아는 사람만 읽고 쓸 수 있어요. 로그인은 없어요.
    // 비밀번호가 걸린 모임은 실제 데이터가 "모임ID--비밀번호해시" 경로에 있어서 ID만으로는 찾을 수 없어요.
    // 전체 모임 목록 조회는 막아서 남의 모임 ID를 알아낼 수 없게 해요.

    // 모임 ID 형식: 영어 소문자·숫자·- 로 2~30자
    function validId(id)  { return id.matches('^[a-z0-9-]{2,30}$'); }
    // 데이터 경로 키: 모임 ID 또는 "모임ID--비밀번호해시" (최대 50자)
    function validKey(key){ return key.matches('^[a-z0-9-]{2,50}$'); }
    // 문서 ID 형식: 영어·숫자·_·- 만 (점이나 특수문자가 들어간 이상한 ID 차단)
    function safeDoc(id)  { return id.matches('^[A-Za-z0-9_-]{1,70}$'); }
    // 문서 하나에 필드는 20개까지
    function small()      { return request.resource.data.size() <= 20; }

    // 비밀번호가 걸린 모임 표시 (만들기만 가능, 수정·삭제 불가)
    match /locks/{room} {
      allow get: if validId(room);
      allow create: if validId(room) && request.resource.data.keys().hasOnly(['at']);
    }

    // 약속 문서: 이름(name), 멤버 목록(people), 만든 시각(c)만 저장 · 멤버는 50명까지
    match /rooms/{key}/trips/{trip} {
      allow get, list: if validKey(key);
      allow create, update: if validKey(key) && safeDoc(trip) && small()
        && request.resource.data.keys().hasOnly(['name', 'people', 'c'])
        && request.resource.data.people is list && request.resource.data.people.size() <= 50;
      allow delete: if validKey(key);

      // 약속 아래 문서: 지출(items), 송금(transfers), 날짜·투표·일정(plan)만 허용
      match /{sub}/{doc} {
        allow get, list: if validKey(key) && sub in ['items', 'transfers', 'plan'];
        allow create, update: if validKey(key) && sub in ['items', 'transfers', 'plan'] && safeDoc(doc) && small();
        allow delete: if validKey(key) && sub in ['items', 'transfers', 'plan'];
      }
    }
  }
}
